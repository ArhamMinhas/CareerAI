# Shares apps/api's dependency layer and codebase (Celery app + tasks live in
# apps/api/app/workers — see apps/worker/README.md); only the entrypoint differs.
# Build context is the repo root.

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY apps/api/requirements/base.txt requirements/base.txt
RUN pip install -r requirements/base.txt

# ---- local development: autoreload not needed for a queue consumer; mirrors prod closely ----
FROM deps AS dev
COPY apps/api/requirements/dev.txt requirements/dev.txt
RUN pip install -r requirements/dev.txt
COPY apps/api /app
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info"]

# ---- production ----
FROM deps AS production
RUN useradd --create-home --shell /bin/false appuser
COPY apps/api /app
USER appuser
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info"]
