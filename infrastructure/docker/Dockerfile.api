# Build context is the repo root (see docker-compose.yml) so this can COPY apps/api.
# docs/DEPLOYMENT.md §3.

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONHASHSEED=random
RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY apps/api/requirements/base.txt requirements/base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements/base.txt

# ---- local development: hot reload, dev/test tooling included ----
FROM deps AS dev
COPY apps/api/requirements/dev.txt requirements/dev.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements/dev.txt
COPY apps/api /app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ---- production: no dev tooling, runs as non-root ----
FROM deps AS production
RUN useradd --create-home --shell /bin/false --uid 1000 appuser
COPY --chown=appuser:appuser apps/api /app
# app/ml/registry.py (Phase 8) reads trained artifacts from here — docker-compose.yml mounts
# the same path for local dev instead; this COPY is what a real (non-Compose) production build
# needs, since it has no compose-level volume injection. If ml/models/ is empty (no models
# trained yet), this just creates an empty directory — registry.py degrades gracefully.
COPY --chown=appuser:appuser ml/models /app/ml_models
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--access-log"]
