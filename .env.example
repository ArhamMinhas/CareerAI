# CareerAI — environment variables
# Copy to .env and fill in real values. Never commit .env. See docs/SECURITY.md and
# docs/CONTRIBUTING.md#8-adding-an-environment-variable for the rules governing this file.

# ---------------------------------------------------------------------------
# App / general
# ---------------------------------------------------------------------------
NODE_ENV=development                       # development | staging | production
ENVIRONMENT=development                    # mirrors NODE_ENV for the FastAPI app

# Canonical public site URL — MUST match the deployed domain exactly.
# Used for metadata, canonical URLs, sitemap, and OG image generation. See docs/SEO.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API base URL the frontend calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector) — docs/DATABASE.md
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://careerai:careerai@localhost:5432/careerai
# Sync variant, used by Alembic migrations.
DATABASE_URL_SYNC=postgresql://careerai:careerai@localhost:5432/careerai

# ---------------------------------------------------------------------------
# Redis — cache, rate limiting, Celery broker/result backend
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Authentication — Supabase (docs/SECURITY.md)
# ---------------------------------------------------------------------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                 # backend-only. NEVER expose to the frontend.
SUPABASE_JWT_SECRET=                       # used by the API to verify JWTs

# ---------------------------------------------------------------------------
# Object storage — resume files (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=                      # only needed for non-AWS S3-compatible providers

# ---------------------------------------------------------------------------
# AI / LLM providers — docs/AI_ARCHITECTURE.md (provider abstraction; only one required to boot)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai                        # openai | gemini — selects the default provider
LLM_MODEL_DEFAULT=gpt-4o-mini              # cheap/default model for classification-style tasks
LLM_MODEL_REASONING=gpt-4o                 # stronger model for extraction/evaluation/explanation
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# SEO & discoverability — docs/SEO.md
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=                  # Google Search Console verification meta tag value
BING_SITE_VERIFICATION=                    # Bing Webmaster Tools verification value
NEXT_PUBLIC_ANALYTICS_ID=                  # GA4 measurement ID or Plausible site ID
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible   # plausible | ga4

# ---------------------------------------------------------------------------
# Security / misc
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=                                # FastAPI session/cookie signing key
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=20
