# CareerAI — environment variables
# Copy to .env and fill in real values. Never commit .env. See docs/SECURITY.md and
# docs/CONTRIBUTING.md#8-adding-an-environment-variable for the rules governing this file.

# ---------------------------------------------------------------------------
# App / general
# ---------------------------------------------------------------------------
NODE_ENV=development                       # development | staging | production
ENVIRONMENT=development                    # mirrors NODE_ENV for the FastAPI app

# Canonical public site URL — MUST match the deployed domain exactly.
# Used for metadata, canonical URLs, sitemap, and OG image generation. See docs/SEO.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API base URL the *browser* calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only override for API calls made from inside the web app's own server (SSR/SSG for
# public content pages — /careers, /skills/[slug]). Not read by the browser, so no
# NEXT_PUBLIC_ prefix. Only needed when the web server and API aren't reachable at the same
# URL — e.g. in Docker Compose, where the browser reaches the API via its published port
# (localhost:8000) but the web container itself must reach it via the Docker network's service
# name instead. Set automatically in infrastructure/docker/docker-compose.yml; leave unset for
# a bare-metal/non-Docker setup where both URLs are the same.
API_INTERNAL_URL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector) — docs/DATABASE.md
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://careerai:careerai@localhost:5432/careerai
# Sync variant — Alembic itself runs async (see apps/api/alembic/env.py); this is reserved
# for any future tooling/scripts that need a plain psycopg2-style sync connection.
DATABASE_URL_SYNC=postgresql://careerai:careerai@localhost:5432/careerai

# ---------------------------------------------------------------------------
# Redis — cache, rate limiting, Celery broker/result backend
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Authentication — Supabase (docs/SECURITY.md)
# ---------------------------------------------------------------------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# The public, browser-safe key. Current Supabase projects call this the "publishable" key
# (sb_publishable_...); older projects call the equivalent value the "anon" key — either
# goes here, @supabase/ssr doesn't care what it's named.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend-only, full-privilege key (sb_secret_... on current projects, "service_role" on
# older ones). NEVER expose to the frontend.
SUPABASE_SECRET_KEY=
# Legacy HS256 projects only — leave blank on current projects (they use asymmetric "JWT
# Signing Keys" instead, verified via SUPABASE_URL's JWKS endpoint with no secret needed).
# See apps/api/app/core/security.py.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Object storage — resume files
# ---------------------------------------------------------------------------
# Supabase Storage bucket name (default path — docs/DEPLOYMENT.md §5).
STORAGE_BUCKET=resumes
# Only populated if using a plain S3-compatible bucket instead of Supabase Storage.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
# Only needed for non-AWS S3-compatible providers.
STORAGE_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# AI / LLM providers — docs/AI_ARCHITECTURE.md (provider abstraction; only one required to boot)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai                        # openai | gemini — selects the default provider
LLM_MODEL_DEFAULT=gpt-4o-mini              # cheap/default model for classification-style tasks
LLM_MODEL_REASONING=gpt-4o                 # stronger model for extraction/evaluation/explanation
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# SEO & discoverability — docs/SEO.md
# ---------------------------------------------------------------------------
# Google Search Console verification meta tag value.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification value.
BING_SITE_VERIFICATION=
# GA4 measurement ID or Plausible site ID.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible   # plausible | ga4

# ---------------------------------------------------------------------------
# Security / misc
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
# FastAPI session/cookie signing key.
SECRET_KEY=
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=20
