# Environment
.env
.env.local
.env.*.local

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML artifacts / data (large binary, not committed — see ml/README.md)
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/data/features/*
!ml/data/features/.gitkeep
ml/models/*
!ml/models/.gitkeep
!ml/models/README.md
# Model cards (docs/ML_PIPELINE.md §6) are tracked; the artifacts they describe are not — a
# directory has to be explicitly re-included before git will look inside it for the file-level
# negations below to take effect.
!ml/models/*/
!ml/models/*/README.md
!ml/models/*/metadata.json
*.pkl
*.joblib
*.onnx

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Local Claude Code tooling state
.claude/

# Logs
*.log

# Build output
dist/
build/
